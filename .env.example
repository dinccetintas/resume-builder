# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# --- Anthropic (tailoring + computer-use apply) ---
ANTHROPIC_API_KEY=

# --- Supabase (database, storage, auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Adzuna job search (free: https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Dedicated email inbox for auto-clearing verification codes (IMAP) ---
# Use a dedicated address + an app password, not your primary password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=

# --- 21st.dev Magic MCP (UI component generation, build-time only) ---
# ROTATE the key you pasted in chat; keep the new one here only.
MAGIC_API_KEY=

# --- Tailoring model (default keeps cost low; opus for top-tier targets) ---
TAILOR_MODEL=claude-sonnet-4-6
